# BikeOS prototype hardware verified over the ESP ROM bootloader on 2026-11-16.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# The connected board uses the ESP32-S3 native USB Serial/JTAG interface.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# BLE peripheral uses the ESP-IDF NimBLE host (not Bluedroid).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# The chip reports 8 MB embedded PSRAM. ESP32-S3 R8 modules use octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Photo-verified 2.8-inch ILI9341 TFT test wiring.
CONFIG_BIKEOS_DISPLAY_ILI9341=y
CONFIG_BIKEOS_ILI9341_SPI_HOST=1
CONFIG_BIKEOS_ILI9341_MOSI_GPIO=11
CONFIG_BIKEOS_ILI9341_CLOCK_GPIO=12
CONFIG_BIKEOS_ILI9341_CS_GPIO=10
CONFIG_BIKEOS_ILI9341_DC_GPIO=5
CONFIG_BIKEOS_ILI9341_RESET_GPIO=4
CONFIG_BIKEOS_ILI9341_CLOCK_HZ=26000000
CONFIG_BIKEOS_DISPLAY_TEST_PATTERN=y

