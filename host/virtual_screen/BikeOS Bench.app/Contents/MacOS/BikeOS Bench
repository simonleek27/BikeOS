#!/bin/zsh
# Double-click launcher: runs bench.sh from the folder this .app sits in.
# Finder starts apps with a minimal PATH, so add the usual tool locations.
export PATH="/usr/local/bin:/opt/homebrew/bin:/Library/Frameworks/Python.framework/Versions/Current/bin:$PATH"
BENCH_DIR="${0:A:h:h:h:h}"
LOG="$HOME/Library/Logs/BikeOS Bench.log"
exec "$BENCH_DIR/bench.sh" >> "$LOG" 2>&1
